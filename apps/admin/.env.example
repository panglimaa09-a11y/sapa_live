# ============================================================================
# SapaLive Admin Control Center — environment
# Aplikasi terpisah di apps/admin. JANGAN simpan secret asli di file ini.
# ============================================================================

# URL project Supabase (sama dengan app utama)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — akses penuh DB, HANYA dipakai server-side di admin.
# JANGAN PERNAH pakai NEXT_PUBLIC_ untuk key ini.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Kunci enkripsi secret MFA (AES-256-GCM), 32 byte → hex 64 karakter.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WAJIB SAMA di semua instance; bila diganti, enroll MFA lama tidak bisa dibaca.
ADMIN_MFA_ENCRYPTION_KEY=<64 hex chars>

# URL publik panel admin (untuk referensi, bukan auth)
ADMIN_PUBLIC_URL=https://admin.sapalive.my.id
