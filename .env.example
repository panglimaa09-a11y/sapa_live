# SapaLive — salin ke .env.local lalu isi nilainya
# Database produksi: sapa_live

# === SERVER ONLY — JANGAN pakai prefix NEXT_PUBLIC, JANGAN ke frontend ===
# Service role key: bypass RLS. Hanya dipakai route handlers via lib/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Pakasir v2 — untuk topup token (addendum v1.1.0)
PAKASIR_PROJECT_SLUG=
PAKASIR_API_KEY=

# 1. Buat project di https://supabase.com (nama: sapa_live)
# 2. Jalankan supabase/schema.sql di SQL Editor
# 3. Settings → API → salin URL + anon key ke bawah ini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Untuk login Google:
# 1. Google Cloud Console → buat OAuth Client ID (Web)
#    Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
#    (tambah juga http://localhost:3000/auth/callback untuk development)
# 2. Supabase Dashboard → Authentication → Providers → Google → aktifkan,
#    masukkan Client ID + Client Secret dari langkah 1

# URL publik aplikasi (untuk OAuth redirect & metadata)
NEXT_PUBLIC_APP_URL=https://sapalive.my.id

# TURN server (produksi, bila banyak user di balik NAT simetris):
# STUN publik gratis sudah cukup untuk awal. Bila perlu TURN, daftar di
# https://www.metered.ca/ (ada free tier) atau self-host coturn,
# lalu tambahkan kredensial TURN di lib/webrtc.ts RTC_CONFIG:
#   { urls: "turn:turn.example.com:3478", username: "...", credential: "..." }

# ----------------------------------------------------------------------------
# ADMIN CONTROL CENTER (apps/admin — aplikasi Next.js terpisah)
# Panel admin memakai SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY di atas
# (didefinisikan di apps/admin/.env). Tambahan khusus admin:
# ----------------------------------------------------------------------------
# Kunci enkripsi secret MFA admin (AES-256-GCM, 32 byte → 64 hex).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_MFA_ENCRYPTION_KEY=
